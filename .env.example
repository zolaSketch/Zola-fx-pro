# ---------------------------------------------------------------------------
# JARVIS runs fully without any of these. A key only upgrades free-form
# conversation to an LLM; every tool, the knowledge core, memory and voice
# work either way.
#
# Verify your setup at http://localhost:3000/api/health
# ---------------------------------------------------------------------------

# Your API key. Works with any OpenAI-compatible provider.
OPENAI_API_KEY=

# Base URL. Must end in /v1. Leave blank for OpenAI itself.
#
#   OpenAI          (default)  https://api.openai.com/v1
#   OpenCode Zen               https://opencode.ai/zen/v1
#   OpenRouter                 https://openrouter.ai/api/v1
#   Groq                       https://api.groq.com/openai/v1
#   Together                   https://api.together.xyz/v1
#   Ollama (local)             http://localhost:11434/v1
#   LM Studio (local)          http://localhost:1234/v1
OPENAI_BASE_URL=

# Model id, as your provider names it.
#
#   OpenAI          gpt-4o-mini
#   OpenCode Zen    claude-sonnet-4-5, gpt-5-nano, deepseek-v4-flash
#   Ollama          llama3.1, qwen2.5
JARVIS_MODEL=gpt-4o-mini

# Retries before failing over to local cognition. Keep low so the HUD never
# hangs when the uplink is unreachable.
JARVIS_MAX_RETRIES=1

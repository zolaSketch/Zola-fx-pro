# Optional. When set, JARVIS uses a real tool-calling LLM for conversation.
# Without it he runs on the built-in offline intent engine and remains fully
# functional — every tool still works.
OPENAI_API_KEY=

# Optional model override (default: gpt-4o-mini)
JARVIS_MODEL=gpt-4o-mini

# Optional. Point at a proxy, OpenRouter, or a local model server
# (e.g. http://localhost:11434/v1 for Ollama).
OPENAI_BASE_URL=
